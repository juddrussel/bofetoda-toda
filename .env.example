# Database Configuration
# Copy this file to .env and fill in your actual values

# For Aiven MySQL:
# DB_HOST=bofetoda-mysql-yourproject.aivencloud.com
# DB_PORT=12345 (your Aiven port)
# DB_USER=avnadmin

# For PlanetScale:
# DB_HOST=aws.connect.psdb.cloud
# DB_PORT=3306
# DB_USER=your-username

# For Local MySQL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root

DB_HOST=your-database-host
DB_PORT=3306
DB_NAME=bofetoda
DB_USER=your-database-username
DB_PASS=your-database-password

# SSL Configuration (leave blank for Aiven/PlanetScale - they auto-enable SSL)
# Set to 'disabled' only for local development
# DB_SSL_MODE=disabled

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila

# Session Settings
SESSION_LIFETIME=7200

# Web Push Notifications (VAPID Keys)
# Generate these keys by running: php generate_vapid_keys.php
# Keep the private key secret - never commit it to version control!
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@bofetoda.com
